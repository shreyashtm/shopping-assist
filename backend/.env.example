# --- Runtime ---------------------------------------------------------------
# Anthropic API key, used for intent interpretation.
# Optional: without it the app falls back to keyword interpretation and
# reports degraded_mode in every response.
ANTHROPIC_API_KEY=

# Interpretation model. One call per completed search -- the user-visible
# explanations are composed from retrieval evidence, not by a second call.
INTERPRET_MODEL=claude-haiku-4-5

# Offline catalogue enrichment. Runs through the Batch API at 50% cost.
ENRICH_MODEL=claude-sonnet-5

# Comma-separated allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# --- Catalogue build (offline scripts only) --------------------------------
# Apify token, used by scripts/fetch_raw.py to download the recorded scrape
# datasets. Not needed to run the app -- the built catalogue is committed.
APIFY_TOKEN=
