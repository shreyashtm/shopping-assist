# --- Runtime ---------------------------------------------------------------
# Which LLM adapter to use for intent interpretation: "anthropic" (default),
# "openrouter", or "local". All three implement the same LLMProvider
# protocol -- switching this does not require any other code change. See
# app/adapters/llm/.
LLM_PROVIDER=anthropic

# Anthropic API key, used when LLM_PROVIDER=anthropic.
# Optional: without a configured provider, the app falls back to keyword
# interpretation and reports degraded_mode in every response.
ANTHROPIC_API_KEY=

# OpenRouter API key, used when LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=

# Used when LLM_PROVIDER=local. No key needed -- points at a local model
# server (e.g. `ollama serve`, default port). Costs nothing per call, at the
# cost of materially weaker structured-output reliability than a hosted
# model; good for free iteration, not a drop-in production replacement.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1/chat/completions

# Interpretation model. One call per completed search -- the user-visible
# explanations are composed from retrieval evidence, not by a second call.
# Use an Anthropic model id ("claude-haiku-4-5") for LLM_PROVIDER=anthropic,
# an OpenRouter-routed model id (e.g. "anthropic/claude-haiku-4.5",
# "openai/gpt-4o-mini") for LLM_PROVIDER=openrouter, or a name from
# `ollama list` for LLM_PROVIDER=local.
INTERPRET_MODEL=claude-haiku-4-5

# Offline catalogue enrichment. Runs through the Batch API at 50% cost.
ENRICH_MODEL=claude-sonnet-5

# Comma-separated allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# --- Catalogue build (offline scripts only) --------------------------------
# Apify token, used by scripts/fetch_raw.py to download the recorded scrape
# datasets. Not needed to run the app -- the built catalogue is committed.
APIFY_TOKEN=
